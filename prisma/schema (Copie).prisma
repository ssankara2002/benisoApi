generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int               @id @default(autoincrement())
  nom                  String
  prenom               String
  email                String            @unique
  password             String
  adresse              String?
  phone                String?
  actif                Boolean           @default(true)
  hasAssociation       Boolean           @default(false)
  resetPasswordToken   String?           @unique
  resetPasswordExpires DateTime?
  roleId               Int?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  accueils             Accueil[]
  actualites           Actualite[]
  contacts             Contact[]
  cours                Cours[]
  eleve                Eleve?
  evenements           Evenement[]
  galeries             Gallery[]
  leavePermissions     LeavePermission[]
  parent               Parent?
  presentations        Presentation[]
  eleves               SiteEleve[]
  staff                Staff?
  role                 Role?             @relation(fields: [roleId], references: [id], onDelete: NoAction)
  videos               Video[]
  absencesCreated      Absence[]         @relation("AbsenceCreatedBy")
  retardsCreated       Retard[]          @relation("RetardCreatedBy")
}

model Role {
  id             Int          @id @default(autoincrement())
  name           String       @unique
  description    String?
  hasAssociation Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  permissions    Permission[] @relation("RolesOnPermissions")
  users          User[]
}

model Permission {
  id             Int      @id @default(autoincrement())
  key            String   @unique
  description    String?
  hasAssociation Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  roles          Role[]   @relation("RolesOnPermissions")
}

model Parent {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  hasAssociation Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eleves         Eleve[]  @relation("ParentEleves")
}

model Staff {
  id             Int          @id @default(autoincrement())
  userId         Int          @unique
  hasAssociation Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  absences       Absence[]
  evaluations    Evaluation[]
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Eleve {
  id             Int           @id @default(autoincrement())
  matricule      String?       @unique
  userId         Int           @unique
  hasAssociation Boolean       @default(false)
  dateNaissance  DateTime
  acteNaissance  String
  bulletin       String[]
  attestation    String?
  filiereId      Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  absences       Absence[]
  filiere        Filiere?      @relation(fields: [filiereId], references: [id], onDelete: NoAction)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  inscriptions   Inscription[]
  notes          Note[]
  paiements      Paiement[]
  retards        Retard[]
  cours          Cours[]       @relation("EleveCours")
  matieres       Matiere[]     @relation("EleveMatieres")
  parents        Parent[]      @relation("ParentEleves")
}

model Classe {
  id             Int           @id @default(autoincrement())
  nom            String
  capacite       Int?
  hasAssociation Boolean       @default(false)
  niveauId       Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  absences       Absence[]
  niveau         Niveau        @relation(fields: [niveauId], references: [id], onDelete: NoAction)
  evaluations    Evaluation[]
  inscriptions   Inscription[]
  retards        Retard[]
}

model TypeEnseignement {
  id             Int                  @id @default(autoincrement())
  nom            TypeEnseignementEnum @unique
  hasAssociation Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  niveaux        Niveau[]
}

model Niveau {
  id                 Int                @id @default(autoincrement())
  nomNiveau          String             @unique
  cycle              String?
  scolarite          Int?
  hasAssociation     Boolean            @default(false)
  typeEnseignementId Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  classes            Classe[]
  coeficientsNiveau  CoeficientNiveau[]
  cours              Cours[]
  inscriptions       Inscription[]
  typeEnseignement   TypeEnseignement?  @relation(fields: [typeEnseignementId], references: [id], onDelete: NoAction)
  series             Serie[]
  videos             Video[]
}

model Serie {
  id                Int               @id @default(autoincrement())
  nom               String            @unique
  hasAssociation    Boolean           @default(false)
  niveauId          Int
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  coefficientsSerie CoeficientSerie[]
  niveau            Niveau            @relation(fields: [niveauId], references: [id], onDelete: NoAction)
}

model CoeficientNiveau {
  id             Int      @id @default(autoincrement())
  valeur         Int
  hasAssociation Boolean  @default(false)
  niveauId       Int
  matiereId      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  matiere        Matiere  @relation(fields: [matiereId], references: [id], onDelete: NoAction)
  niveau         Niveau   @relation(fields: [niveauId], references: [id], onDelete: NoAction)

  @@unique([niveauId, matiereId])
}

model CoeficientSerie {
  id             Int      @id @default(autoincrement())
  valeur         Int
  hasAssociation Boolean  @default(false)
  matiereId      Int
  serieId        Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  matiere        Matiere  @relation(fields: [matiereId], references: [id], onDelete: NoAction)
  serie          Serie    @relation(fields: [serieId], references: [id], onDelete: NoAction)

  @@unique([matiereId, serieId])
}

model Annee {
  id             Int           @id @default(autoincrement())
  dateDebut      DateTime?
  dateFin        DateTime?
  hasAssociation Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  evaluations    Evaluation[]
  inscriptions   Inscription[]
  trimestres     Trimestre[]
}

model Trimestre {
  id             Int          @id @default(autoincrement())
  nom            String
  dateDebut      DateTime?
  dateFin        DateTime?
  hasAssociation Boolean      @default(false)
  anneeId        Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  evaluations    Evaluation[]
  annee          Annee        @relation(fields: [anneeId], references: [id], onDelete: NoAction)
}

model Inscription {
  id             Int        @id @default(autoincrement())
  eleveId        Int
  anneeId        Int
  hasAssociation Boolean    @default(false)
  createdAt      DateTime   @default(now())
  niveauId       Int
  classeId       Int?
  annee          Annee      @relation(fields: [anneeId], references: [id], onDelete: NoAction)
  classe         Classe?    @relation(fields: [classeId], references: [id], onDelete: NoAction)
  eleve          Eleve      @relation(fields: [eleveId], references: [id], onDelete: NoAction)
  niveau         Niveau     @relation(fields: [niveauId], references: [id], onDelete: NoAction)
  paiements      Paiement[]
}

model Paiement {
  id                Int         @id @default(autoincrement())
  date              DateTime
  modePaiement      String?
  montant           Int
  inscriptionId     Int
  eleveId           Int?
  moneroTxHash      String?
  moneroAddress     String?
  moneroAmount      String?
  moneroStatus      String?     @default("pending")
  moneroBlockHeight Int?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  eleve             Eleve?      @relation(fields: [eleveId], references: [id], onDelete: NoAction)
  inscription       Inscription @relation(fields: [inscriptionId], references: [id], onDelete: NoAction)
}

model TypeMatiere {
  id             Int       @id @default(autoincrement())
  libelle        String
  hasAssociation Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  matieres       Matiere[]
}

model Matiere {
  id                Int                @id @default(autoincrement())
  libelle           String             @unique
  hasAssociation    Boolean            @default(false)
  typeMatiereId     Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  absences          Absence[]
  coeficientsNiveau CoeficientNiveau[]
  coefficientsSerie CoeficientSerie[]
  cours             Cours[]
  evaluations       Evaluation[]
  typeMatiere       TypeMatiere?       @relation(fields: [typeMatiereId], references: [id], onDelete: NoAction)
  retards           Retard[]
  videos            Video[]
  eleves            Eleve[]            @relation("EleveMatieres")
  specialites       Specialite[]       @relation("SpecialiteMatieres")
}

model Retard {
  id            Int      @id @default(autoincrement())
  date          DateTime
  autorisation  String?
  justification Boolean
  confProf      Boolean
  eleveId       Int
  matiereId     Int
  classeId      Int
  userId        Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  classe        Classe   @relation(fields: [classeId], references: [id], onDelete: NoAction)
  eleve         Eleve    @relation(fields: [eleveId], references: [id], onDelete: NoAction)
  matiere       Matiere  @relation(fields: [matiereId], references: [id], onDelete: NoAction)
  user          User?    @relation("RetardCreatedBy", fields: [userId], references: [id], onDelete: NoAction)
}

model Absence {
  id            Int      @id @default(autoincrement())
  dateDebut     DateTime
  dateFin       DateTime
  motif         String
  justification Boolean
  eleveId       Int?
  staffId       Int?
  matiereId     Int
  classeId      Int
  userId        Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  classe        Classe   @relation(fields: [classeId], references: [id], onDelete: NoAction)
  eleve         Eleve?   @relation(fields: [eleveId], references: [id], onDelete: NoAction)
  matiere       Matiere  @relation(fields: [matiereId], references: [id], onDelete: NoAction)
  staff         Staff?   @relation(fields: [staffId], references: [id], onDelete: NoAction)
  user          User?    @relation("AbsenceCreatedBy", fields: [userId], references: [id], onDelete: NoAction)
}

model Evaluation {
  id             Int        @id @default(autoincrement())
  type           String
  date           DateTime
  bareme         Float?
  hasAssociation Boolean    @default(false)
  staffId        Int?
  matiereId      Int?
  classeId       Int?
  trimestreId    Int?
  anneeId        Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  annee          Annee?     @relation(fields: [anneeId], references: [id], onDelete: NoAction)
  classe         Classe?    @relation(fields: [classeId], references: [id], onDelete: NoAction)
  matiere        Matiere?   @relation(fields: [matiereId], references: [id], onDelete: NoAction)
  staff          Staff?     @relation(fields: [staffId], references: [id], onDelete: NoAction)
  trimestre      Trimestre? @relation(fields: [trimestreId], references: [id], onDelete: NoAction)
  notes          Note[]
}

model Note {
  id           Int         @id @default(autoincrement())
  valeur       Float
  eleveId      Int
  evaluationId Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  eleve        Eleve       @relation(fields: [eleveId], references: [id], onDelete: NoAction)
  evaluation   Evaluation? @relation(fields: [evaluationId], references: [id], onDelete: NoAction)
}

model LeavePermission {
  id        Int       @id @default(autoincrement())
  motif     String?
  dateDebut DateTime?
  dateFin   DateTime?
  statut    String    @default("en enntente")
  userId    Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User?     @relation(fields: [userId], references: [id])
}

model Evenement {
  id             Int             @id @default(autoincrement())
  nom            String
  dateDebut      DateTime?
  dateFin        DateTime?
  lieu           String?
  image          String?
  hasAssociation Boolean         @default(false)
  statut         StatutEvenement @default(EN_ATTENTE)
  userId         Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User?           @relation(fields: [userId], references: [id])
}

model Specialite {
  id             Int       @id @default(autoincrement())
  nom            String    @unique
  hasAssociation Boolean   @default(false)
  filiereId      Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  filiere        Filiere   @relation(fields: [filiereId], references: [id], onDelete: NoAction)
  matieres       Matiere[] @relation("SpecialiteMatieres")
}

model Filiere {
  id             Int          @id @default(autoincrement())
  nom            String       @unique
  hasAssociation Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  eleves         Eleve[]
  specialites    Specialite[]
}

model Accueil {
  id          Int      @id @default(autoincrement())
  nom         String
  description String?
  images      String[]
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Presentation {
  id          Int      @id @default(autoincrement())
  description String?
  histoire    String?
  mission     String?
  phone       String?
  reseau      Json?
  email       String?
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Gallery {
  id          Int      @id @default(autoincrement())
  image       String
  description String?
  userId      Int
  typeId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  type        Type     @relation(fields: [typeId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Type {
  id             Int         @id @default(autoincrement())
  nom            String
  hasAssociation Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  actualites     Actualite[]
  galleries      Gallery[]
}

model Contact {
  id        Int      @id @default(autoincrement())
  nom       String
  prenom    String?
  email     String
  typeSujet String?
  message   String?
  userId    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Cours {
  id          Int      @id @default(autoincrement())
  nom         String
  description String?
  file        String?
  userId      Int
  niveauId    Int?
  matiereId   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  matiere     Matiere? @relation(fields: [matiereId], references: [id])
  niveau      Niveau?  @relation(fields: [niveauId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eleves      Eleve[]  @relation("EleveCours")
}

model Video {
  id          Int      @id @default(autoincrement())
  fileVideo   String
  description String?
  userId      Int
  niveauId    Int?
  matiereId   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  matiere     Matiere? @relation(fields: [matiereId], references: [id])
  niveau      Niveau?  @relation(fields: [niveauId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SiteEleve {
  id        Int      @id @default(autoincrement())
  nom       String
  prenom    String?
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Actualite {
  id                Int      @id @default(autoincrement())
  nom               String
  date              DateTime @default(now())
  description       String?
  imageIllustration String?
  typeId            Int
  userId            Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  type              Type     @relation(fields: [typeId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TypeEnseignementEnum {
  GENERAL
  TECHNIQUE
  PRIMAIRE
  MATERNELLE
  CRECHE
}

enum StatutEvenement {
  EN_ATTENTE
  EN_COURS
  TERMINE
}
