# Environnement
NODE_ENV=production
PORT=5000

# Base de données
DATABASE_URL="postgresql://username:password@localhost:5432/gestion_ecole"

# JWT
JWT_SECRET="votre_clé_secrète_jwt_très_sécurisée"

# CORS - Domaines autorisés (séparés par des virgules)
# Important : Inclure TOUS les domaines (backend ET frontend)
CORS_ORIGIN="https://admin.edutrackhub.cloud,https://sainte-anne.edutrackhub.cloud,http://localhost:5173"

# Mobile Money Togo - FedaPay API
# Mode: "sandbox" (test) ou "production" (réel)
FEDAPAY_MODE=sandbox
# Clé API FedaPay (obtenir sur https://fedapay.com)
FEDAPAY_SECRET_KEY="sk_sandbox_votre_cle_secrete_fedapay"
# URL de callback pour les webhooks FedaPay
BACKEND_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# Stripe API
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
